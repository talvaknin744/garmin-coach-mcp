# Garmin token mode. Keep this file secret if you fill it in; do not commit it.
GARMIN_TOKEN=
GARMIN_API_BASE_URL=https://connectapi.garmin.com
GARMIN_HTTP_TIMEOUT_SECONDS=30
GARMIN_IMPERSONATE=chrome

# Local stdio defaults. For Render set MCP_TRANSPORT=streamable-http.
MCP_TRANSPORT=stdio
PORT=8788
MCP_BIND_HOST=127.0.0.1
MCP_ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274

# Required for Streamable HTTP/Auth0 mode.
MCP_PUBLIC_URL=http://localhost:8788
MCP_RESOURCE_URL=http://localhost:8788/mcp
AUTH0_ISSUER=https://<tenant>.auth0.com/
AUTH0_AUDIENCE=http://localhost:8788/mcp
AUTH0_ALLOWED_SUBJECT=<auth0-subject>
